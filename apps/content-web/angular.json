{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "sourceMap": true,
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets"
            ],
            "styles": [
              "src/assets/theme/css/bootstrap.min.css",
              "src/assets/theme/css/all.min.css",
              "src/assets/theme/css/animate.css",
              "src/assets/theme/css/magnific-popup.css",
              "src/assets/theme/css/meanmenu.css",
              "src/assets/theme/css/swiper-bundle.min.css",
              "src/assets/theme/css/nice-select.css",
              "src/assets/theme/css/main.css",
              "src/styles.css"
            ],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "app:build",
            "host": "0.0.0.0",
            "allowedHosts": [
              "ec2-3-27-156-182.ap-southeast-2.compute.amazonaws.com"
            ]
          }
        }
      }
    }
  }
}
